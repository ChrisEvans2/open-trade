[Unit]
Description=Independent trading research health check
After=network-online.target

[Service]
Type=oneshot
User=trading-doctor
Group=trading-doctor
WorkingDirectory=/opt/trading-agent
EnvironmentFile=/etc/trading-agent/doctor.env
ExecStart=/opt/trading-agent/.venv/bin/ta --config /etc/trading-agent/doctor.yaml doctor --notify --json
TimeoutStartSec=40
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/trading-doctor
