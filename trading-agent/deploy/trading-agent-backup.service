[Unit]
Description=Daily trading research PostgreSQL backup
After=postgresql.service

[Service]
Type=oneshot
User=trading-backup
Group=trading-backup
WorkingDirectory=/opt/trading-agent
EnvironmentFile=/etc/trading-agent/backup.env
ExecStart=/opt/trading-agent/.venv/bin/python -m trading_agent.storage.backups backup --directory /var/backups/trading-agent
TimeoutStartSec=16min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/trading-agent
